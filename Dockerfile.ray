# Ray Serve (GPU): pyannote + bge-m3 в одном контейнере (`serve run` multi-app).
#
# CUDA 12 libs (cuBLAS, cuDNN, …): faster-whisper/ctranslate2 ищут libcublas.so.12 —
# python:bookworm без них даёт HTTP 500 на /transcribe.
#
# Сборка:
#   docker build -f Dockerfile.ray -t whisper-ray:latest .

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04 AS cuda-libs
RUN mkdir -p /export/cuda-lib64 \
    && cp -a /usr/local/cuda/lib64/. /export/cuda-lib64/ \
    && test -n "$(find /export/cuda-lib64 -name 'libcublas.so*' -print -quit)"

FROM python:3.12-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PIP_DEFAULT_TIMEOUT=4000 \
    CUDA_HOME=/usr/local/cuda \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64

RUN mkdir -p /usr/local/cuda/lib64
COPY --from=cuda-libs /export/cuda-lib64/ /usr/local/cuda/lib64/

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-dev \
    python3-pip \
    build-essential \
    ffmpeg \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && ln -sf /usr/bin/python3 /usr/local/bin/python3

RUN python3 -m venv /opt/venv \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && ln -sf /root/.local/bin/uv /usr/local/bin/uv

ARG UV_GROUP_FLAGS="--group inference --group serve"

WORKDIR /app

COPY pyproject.toml uv.lock* ./

RUN uv sync --frozen --no-install-project ${UV_GROUP_FLAGS}

COPY . /app/

EXPOSE 8000 8265

CMD ["/bin/bash", "-c", "exec /opt/venv/bin/serve run /app/k8s/ray/serve-multiapp.yaml --blocking"]
