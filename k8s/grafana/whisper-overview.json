    {
      "id": 6,
      "title": "GPU VRAM",
      "description": "Нужны метрики inference_gpu_memory_used_bytes и inference_gpu_memory_total_bytes (NVML) на скрейпе воркера.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false,
            "lineWidth": 2,
            "lineStyle": {
              "fill": "solid"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(max by (gpu_index) (inference_gpu_memory_used_bytes)) / clamp_min(sum(max by (gpu_index) (inference_gpu_memory_total_bytes)), 1)",
          "legendFormat": "VRAM"
        }
      ]
    },
    {
