# Только MLflow UI + sqlite backend (~300–600 MB). Не тянет PyTorch/CUDA.
# Сборка: docker build -f Dockerfile.mlflow -t whisper-mlflow:latest .
FROM python:3.12-slim-bookworm

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && pip install --no-cache-dir "mlflow>=3.7,<4"

WORKDIR /app
RUN mkdir -p /app/mlruns && touch /app/mlflow.db

EXPOSE 8080
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "8080", \
     "--backend-store-uri", "sqlite:////app/mlflow.db", \
     "--default-artifact-root", "/app/mlruns"]
